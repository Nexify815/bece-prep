  "glossary": [
    {
      "id": "ak-001",
      "term": "Maakye",
      "definition": "The Akan word for 'Good morning'. A greeting used in the morning.",
      "example": "Maakye, agya! — Good morning, father!",
      "difficulty": "easy",
      "strand": "Greetings",
      "subStrand": "Greetings & Politeness",
      "level": "B7"
    },
    {
      "id": "ak-002",
      "term": "Mahaha",
      "definition": "The Akan word for 'Good afternoon'. A greeting used in the afternoon.",
      "example": "Mahaha, ɔkyerɛkyerɛni! — Good afternoon, teacher!",
      "difficulty": "easy",
      "strand": "Greetings",
      "subStrand": "Greetings & Politeness",
      "level": "B7"
    },
    {
      "id": "ak-003",
      "term": "Mema wo akye",
      "definition": "A polite Akan phrase meaning 'I greet you' or 'I bid you good day'.",
      "example": "Mema wo akye, ɔbaa — I greet you, madam.",
      "difficulty": "medium",
      "strand": "Greetings",
      "subStrand": "Greetings & Politeness",
      "level": "B7"
    },
    {
      "id": "ak-004",
      "term": "Medaase",
      "definition": "The Akan word meaning 'Thank you'.",
      "example": "Medaase, me wura. — Thank you, sir.",
      "difficulty": "easy",
      "strand": "Greetings",
      "subStrand": "Politeness",
      "level": "B7"
    },
    {
      "id": "ak-005",
      "term": "Aane",
      "definition": "The Akan word meaning 'Yes'.",
      "example": "Aane, mɛkɔ. — Yes, I will go.",
      "difficulty": "easy",
      "strand": "Words",
      "subStrand": "Simple Words",
      "level": "B7"
    },
    {
      "id": "ak-006",
      "term": "Daabi",
      "definition": "The Akan word meaning 'No'.",
      "example": "Daabi, menntumi. — No, I cannot.",
      "difficulty": "easy",
      "strand": "Words",
      "subStrand": "Simple Words",
      "level": "B7"
    },
    {
      "id": "ak-007",
      "term": "Nsu",
      "definition": "The Akan word for 'water'.",
      "example": "Mepe nsu — I want water.",
      "difficulty": "easy",
      "strand": "Everyday",
      "subStrand": "The Home & Nature",
      "level": "B7"
    },
    {
      "id": "ak-008",
      "term": "Dan",
      "definition": "The Akan word for 'house' or 'room'.",
      "example": "Me dan no so — My house is big.",
      "difficulty": "easy",
      "strand": "Everyday",
      "subStrand": "The Home & Nature",
      "level": "B7"
    },
    {
      "id": "ak-009",
      "term": "Aban",
      "definition": "The Akan word for 'government'.",
      "example": "Aban no boa nnipa — The government helps people.",
      "difficulty": "medium",
      "strand": "Community",
      "subStrand": "Society & Government",
      "level": "B8"
    },
    {
      "id": "ak-010",
      "term": "Oman",
      "definition": "The Akan word for 'nation' or 'country'.",
      "example": "Ghana yɛ oman — Ghana is a nation.",
      "difficulty": "medium",
      "strand": "Community",
      "subStrand": "Society & Government",
      "level": "B8"
    },
    {
      "id": "ak-011",
      "term": "Abusua",
      "definition": "The Akan word for 'family' or 'clan'.",
      "example": "Me abusua yɛ kɛse — My family is large.",
      "difficulty": "medium",
      "strand": "Community",
      "subStrand": "Family & Kinship",
      "level": "B8"
    },
    {
      "id": "ak-012",
      "term": "Onyankopɔn",
      "definition": "The Akan word for 'God' most high.",
      "example": "Yeda Onyankopɔn ase — We thank God.",
      "difficulty": "hard",
      "strand": "Community",
      "subStrand": "Customs & Beliefs",
      "level": "B8"
    }
